PORT=3001

# Supabase — get from Project Settings → API Keys (secret key, sb_secret_...)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_secret_key

# CORS — set to your production origin (no trailing slash)
ALLOWED_ORIGIN=https://yourapp.example.com

# Paddle — get from Paddle dashboard
PADDLE_WEBHOOK_SECRET=your_webhook_secret
PADDLE_API_KEY=your_paddle_api_key
PADDLE_SANDBOX=false

# EmailJS — get from emailjs.com dashboard
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PRIVATE_KEY=your_private_key

# Transit position collector — Cloudflare R2 (S3-compatible).
# Create a bucket + R2 API token in Cloudflare Dashboard → R2.
# Collector stays disabled while these are empty.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=urbanyx-transit

# Myhome.ge listing mirror — public API, no key needed. Off until set to true.
# Discovery pulls metadata in bulk; enrichment fetches coordinates one listing
# at a time (the list endpoint withholds lat/lng above per_page=3), so keep the
# scope tight and the per-run budget modest.
MYHOME_SYNC_ENABLED=false
MYHOME_SYNC_CRON=17 * * * *
MYHOME_ENRICH_CRON=*/20 * * * *
MYHOME_ENRICH_PER_RUN=300
# Geocode these property types first (4 = land plot). Others follow after.
MYHOME_ENRICH_PRIORITY_TYPES=4
MYHOME_PER_PAGE=500
# JSON filter applied to discovery, e.g. {"cities":1} for Tbilisi only.
# Leave as {} to mirror the whole country (~344k listings).
MYHOME_FILTERS={}
